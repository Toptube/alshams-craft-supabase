# Active Free-Tier AI Providers (Configure actual keys in Settings > Secrets)
# Groq (Free tier: fast Arabic/English text, tools & Whisper voice transcription)
GROQ_API_KEY=
GROQ_API_KEY_SECONDARY=
GROQ_MODEL=openai/gpt-oss-120b

# Fanar Arabic AI (Free Arabic LLM Backup)
FANAR_API_KEY=
FANAR_MODEL=Fanar

# Taygos Multi-Provider Gateway (Alshams Craft — URL & model routing are preconfigured automatically)
TAYGOS_API_KEY=

# Ollama Cloud API (alshamsawya — Cloud endpoint & models are preconfigured automatically)
OLLAMA_API_KEY=

# Google Gemini Free-Tier Custom Keys ONLY (zero paid/billing models — ignores platform GEMINI_API_KEY)
GEMINI_API_KEY_FALCON_CHAT=
GEMINI_API_KEY_FALCON_VISION=
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Database (Supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push Notifications (Optional — auto-generated and persisted if omitted)
# VAPID_PUBLIC_KEY must be the 87-char Base64URL public key (starts with B...)
# VAPID_PRIVATE_KEY must be the 43-char Base64URL private key
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# App Limits & Config
FALCON_DAILY_LIMIT=20
SHAMOUSA_DAILY_LIMIT=50
NODE_ENV=development