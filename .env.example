# Active AI Providers (Configure actual keys in Settings > Secrets)
# Groq (Primary fast text, tools & Arabic Whisper voice transcription)
GROQ_API_KEY=
GROQ_API_KEY_SECONDARY=
GROQ_MODEL=openai/gpt-oss-120b

# Fanar Arabic AI (Backup Arabic LLM)
FANAR_API_KEY=
FANAR_MODEL=Fanar

# Google Gemini (Shared + Optional Dedicated 3-Engine Keys for Saqr: Chat, Vision, Photo Studio)
GEMINI_API_KEY=
GEMINI_API_KEY_FALCON_CHAT=
GEMINI_API_KEY_FALCON_VISION=
GEMINI_API_KEY_FALCON_IMAGE=
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Database (Supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push Notifications (Optional — auto-generated and persisted if omitted)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# App Limits & Config
FALCON_DAILY_LIMIT=20
SHAMOUSA_DAILY_LIMIT=50
NODE_ENV=development